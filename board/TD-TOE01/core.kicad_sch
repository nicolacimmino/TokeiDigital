	(text "RX"
		(exclude_from_sim no)
		(at 82.55 92.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "214c15fa-1db1-4e54-9171-23f1742ac7d4")
	)
	(text "*1) C4 should be omitted if the Arduino \nbootloader is flashed. This allows for a\nmore reliable reset when the DTR line is toggled.\n\nIterations past REV.A will remove this cap anyway.\n\n*2) While PD7 is not connected to the board it is used\nas an output sending a heartbeat with a 1Hz frequency.\nThis can be used to check the firmware is running.\nIf this pins goes high once every 8s instead it means\nthe firmware is getting hung somewhere (most likely \ncommunication with the DS1307) and the WDT is resetting."
		(exclude_from_sim no)
		(at 32.766 182.372 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "30762f96-27b8-435c-bb86-60352c9fe52d")
	)
